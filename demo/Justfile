# Settings — standalone demo GUI (demo/schema.toml embedded)
#
# Usage:
#   just init                  — refresh derived assets (run after clone / icon changes)
#   just dev                  — unsigned build for the current platform
#   just darwin-build-arm64   — macOS .app → dist/darwin-arm64/
#   just linux-release        — Linux zip + deb + AppImage
#   just darwin-notarize-arm64
#
# Prerequisites:
#   macOS:  rustup target add aarch64-apple-darwin x86_64-apple-darwin
#   Windows cross:
#     macOS:  brew install mingw-w64
#     Linux:  apt install gcc-mingw-w64-x86-64   (Debian/Ubuntu)
#     rustup target add x86_64-pc-windows-gnu
#   ICO:    ImageMagick  (macOS: brew install imagemagick)
#   DMG:    pipx install dmgbuild

set windows-shell := ["sh", "-cu"]

app_name  := "Settings"
exe_name  := "settings"
bundle_id := "jp.emotiongraphics.settings"
min_macos := "11.0"
version   := `awk -F'"' '/^version *=/{print $2; exit}' ../Cargo.toml`

dist := "dist"

arch_darwin_arm64 := "darwin-arm64"
arch_darwin_x86   := "darwin-x86_64"
arch_win          := "windows-x86_64"
arch_linux        := "linux-x86_64"

rust_target_arm64 := "aarch64-apple-darwin"
rust_target_x86   := "x86_64-apple-darwin"
win_target        := "x86_64-pc-windows-gnu"
win_target_dir    := "/tmp/settings-demo-win"

schema_path     := "schema.toml"
config_path     := "config.toml"
dmg_settings    := "dmg_settings.py"
entitlements    := "entitlements.plist"
icon_src_macos  := "assets/appicon-macos.png"
iconset         := dist + "/AppIcon.iconset"

root_just := "../Justfile"

default: help

help:
    @just --list

# ---------------------------------------------------------------------------
# Entry points
# ---------------------------------------------------------------------------

# Refresh derived assets. Safe to re-run after clone or when icon PNGs change.
init: _init-icons _init-appicon-ico init-macos-icns _init-hints
    @echo ">>> init complete"

_init-icons:
    SCHEMA="{{justfile_directory()}}/{{schema_path}}" just --justfile {{root_just}} icons

_init-appicon-ico:
    just --justfile {{root_just}} appicon-ico

[macos]
init-macos-icns:
    #!/usr/bin/env bash
    set -euo pipefail
    ICON_PNG="{{justfile_directory()}}/{{icon_src_macos}}"
    ICON_ICNS="{{justfile_directory()}}/assets/AppIcon.icns"
    if [ ! -f "${ICON_PNG}" ]; then
        echo "Note: ${ICON_PNG} not found — skipping AppIcon.icns"
        exit 0
    fi
    just --justfile {{root_just}} _darwin-icns-build "${ICON_PNG}" "${ICON_ICNS}"
    echo ">>> Generated: assets/AppIcon.icns"

[linux]
init-macos-icns:
    @echo "Note: AppIcon.icns requires macOS (iconutil) — skipped on Linux"

[windows]
init-macos-icns:
    @echo "Note: AppIcon.icns requires macOS (iconutil) — skipped on Windows"

_init-hints:
    #!/usr/bin/env bash
    case "$(uname -s)" in
        Darwin)
            for t in {{rust_target_arm64}} {{rust_target_x86}} {{win_target}}; do
                rustup target list --installed 2>/dev/null | grep -qx "${t}" || \
                    echo "Note: rustup target add ${t}"
            done
            command -v dmgbuild >/dev/null 2>&1 || \
                echo "Note: pipx install dmgbuild  (for DMG packaging)"
            ;;
        Linux)
            command -v nfpm >/dev/null 2>&1 || \
                echo "Note: install nfpm  (for .deb packaging)"
            command -v x86_64-w64-mingw32-gcc >/dev/null 2>&1 || \
                echo "Note: apt install gcc-mingw-w64-x86-64  (for Windows cross-compile)"
            rustup target list --installed 2>/dev/null | grep -qx "{{win_target}}" || \
                echo "Note: rustup target add {{win_target}}"
            ;;
        MINGW*|MSYS*)
            ;;
    esac
    command -v magick >/dev/null 2>&1 || \
        echo "Note: install ImageMagick  (for appicon.ico)"

[macos]
dev:
    #!/usr/bin/env bash
    case "$(uname -m)" in
        arm64) just darwin-build-arm64 ;;
        *)     just darwin-build-x86_64 ;;
    esac

[linux]
dev: linux-build

[windows]
dev: win-build

release: darwin-release win-release linux-release

darwin-release: darwin-notarize-arm64 darwin-notarize-x86_64

win-release: win-zip

linux-release: linux-zip linux-deb linux-appimage

[macos]
install: darwin-build-arm64
    rm -rf "/Applications/{{app_name}}.app"
    cp -r "{{dist}}/{{arch_darwin_arm64}}/{{app_name}}.app" "/Applications/"

[linux]
install: linux-build
    mkdir -p "$HOME/.local/bin"
    cp "{{dist}}/{{arch_linux}}/{{exe_name}}" "$HOME/.local/bin/{{exe_name}}"
    chmod +x "$HOME/.local/bin/{{exe_name}}"

[windows]
install: win-build
    mkdir -p "$LOCALAPPDATA/Programs/{{exe_name}}"
    cp "{{dist}}/{{arch_win}}/{{app_name}}.exe" \
        "$LOCALAPPDATA/Programs/{{exe_name}}/"

# ---------------------------------------------------------------------------
# Per-platform builds → demo/dist/
# ---------------------------------------------------------------------------

darwin-build: darwin-build-arm64 darwin-build-x86_64

darwin-build-arm64: _ensure-icons
    just _darwin-bundle {{arch_darwin_arm64}} {{rust_target_arm64}}
    @echo ">>> Done: {{dist}}/{{arch_darwin_arm64}}/{{app_name}}.app"
    @echo "    Run:  open '{{dist}}/{{arch_darwin_arm64}}/{{app_name}}.app'"

darwin-build-x86_64: _ensure-icons
    just _darwin-bundle {{arch_darwin_x86}} {{rust_target_x86}}
    @echo ">>> Done: {{dist}}/{{arch_darwin_x86}}/{{app_name}}.app"

[macos]
win-build: _ensure-icons _ensure-appicon-ico
    #!/usr/bin/env bash
    set -euo pipefail
    SCHEMA="{{justfile_directory()}}/{{schema_path}}"
    echo ">>> Building demo Windows .exe  (schema: ${SCHEMA})"
    SETTINGS_SCHEMA="${SCHEMA}" CARGO_TARGET_DIR="{{win_target_dir}}" \
        cargo build --manifest-path ../Cargo.toml --release -p settings --target {{win_target}}
    mkdir -p "{{dist}}/{{arch_win}}"
    cp "{{win_target_dir}}/{{win_target}}/release/settings.exe" \
        "{{dist}}/{{arch_win}}/{{app_name}}.exe"
    cp "{{config_path}}" "{{dist}}/{{arch_win}}/config.toml"
    echo ">>> Output: {{dist}}/{{arch_win}}/{{app_name}}.exe"

[linux]
win-build: _ensure-icons _ensure-appicon-ico
    #!/usr/bin/env bash
    set -euo pipefail
    SCHEMA="{{justfile_directory()}}/{{schema_path}}"
    echo ">>> Building demo Windows .exe  (schema: ${SCHEMA})"
    SETTINGS_SCHEMA="${SCHEMA}" CARGO_TARGET_DIR="{{win_target_dir}}" \
        cargo build --manifest-path ../Cargo.toml --release -p settings --target {{win_target}}
    mkdir -p "{{dist}}/{{arch_win}}"
    cp "{{win_target_dir}}/{{win_target}}/release/settings.exe" \
        "{{dist}}/{{arch_win}}/{{app_name}}.exe"
    cp "{{config_path}}" "{{dist}}/{{arch_win}}/config.toml"
    echo ">>> Output: {{dist}}/{{arch_win}}/{{app_name}}.exe"

[windows]
win-build: _ensure-icons _ensure-appicon-ico
    #!/usr/bin/env bash
    set -euo pipefail
    SCHEMA="{{justfile_directory()}}/{{schema_path}}"
    echo ">>> Building demo Windows .exe  (schema: ${SCHEMA})"
    SETTINGS_SCHEMA="${SCHEMA}" \
        cargo build --manifest-path ../Cargo.toml --release -p settings
    mkdir -p "{{dist}}/{{arch_win}}"
    cp "../target/release/settings.exe" "{{dist}}/{{arch_win}}/{{app_name}}.exe"
    cp "{{config_path}}" "{{dist}}/{{arch_win}}/config.toml"
    echo ">>> Output: {{dist}}/{{arch_win}}/{{app_name}}.exe"

linux-build: _ensure-icons
    #!/usr/bin/env bash
    set -euo pipefail
    SCHEMA="{{justfile_directory()}}/{{schema_path}}"
    echo ">>> Building demo Linux binary  (schema: ${SCHEMA})"
    SETTINGS_SCHEMA="${SCHEMA}" cargo build --manifest-path ../Cargo.toml --release -p settings
    mkdir -p "{{dist}}/{{arch_linux}}"
    cp "../target/release/{{exe_name}}" "{{dist}}/{{arch_linux}}/{{exe_name}}"
    cp "{{config_path}}" "{{dist}}/{{arch_linux}}/config.toml"
    echo ">>> Output: {{dist}}/{{arch_linux}}/{{exe_name}}"

# ---------------------------------------------------------------------------
# Packages
# ---------------------------------------------------------------------------

darwin-zip-arm64: darwin-build-arm64
    ditto -c -k --keepParent \
        "{{dist}}/{{arch_darwin_arm64}}/{{app_name}}.app" \
        "{{dist}}/{{app_name}}-v{{version}}-darwin-arm64.zip"
    @echo ">>> Package: {{dist}}/{{app_name}}-v{{version}}-darwin-arm64.zip"

darwin-zip-x86_64: darwin-build-x86_64
    ditto -c -k --keepParent \
        "{{dist}}/{{arch_darwin_x86}}/{{app_name}}.app" \
        "{{dist}}/{{app_name}}-v{{version}}-darwin-x86_64.zip"
    @echo ">>> Package: {{dist}}/{{app_name}}-v{{version}}-darwin-x86_64.zip"

win-zip: win-build
    #!/usr/bin/env bash
    set -euo pipefail
    ZIP="{{dist}}/{{app_name}}-v{{version}}-windows-x86_64.zip"
    rm -f "${ZIP}"
    cd "{{dist}}/{{arch_win}}" && zip "../$(basename "${ZIP}")" "{{app_name}}.exe" config.toml
    echo ">>> Package: ${ZIP}"

linux-zip: linux-build
    #!/usr/bin/env bash
    set -euo pipefail
    ZIP="{{dist}}/{{app_name}}-v{{version}}-linux-x86_64.zip"
    rm -f "${ZIP}"
    cd "{{dist}}/{{arch_linux}}" && zip "../$(basename "${ZIP}")" "{{exe_name}}" config.toml
    echo ">>> Package: ${ZIP}"

linux-deb: linux-build
    #!/usr/bin/env bash
    set -euo pipefail
    command -v nfpm >/dev/null 2>&1 || \
        { echo "Error: nfpm not found. See packaging/demo-nfpm.yaml" >&2; exit 1; }
    ROOT="{{justfile_directory()}}/.."
    cd "${ROOT}"
    VERSION="{{version}}" nfpm package \
        -f packaging/demo-nfpm.yaml \
        --packager deb \
        --target demo/dist
    DEB="demo/dist/settings-demo-v{{version}}-linux-x86_64.deb"
    GENERATED="demo/dist/settings-demo_{{version}}_amd64.deb"
    rm -f "${DEB}"
    mv "${GENERATED}" "${DEB}"
    echo ">>> Package: ${DEB}"

linux-appimage: linux-build
    #!/usr/bin/env bash
    set -euo pipefail
    test -n "${LINUXDEPLOY:-}" && test -n "${APPIMAGETOOL:-}" || \
        { echo "Error: set LINUXDEPLOY and APPIMAGETOOL" >&2; exit 1; }
    ROOT="{{justfile_directory()}}/.."
    cd "${ROOT}"
    VERSION="{{version}}" LINUXDEPLOY="${LINUXDEPLOY}" APPIMAGETOOL="${APPIMAGETOOL}" \
        packaging/build-demo-appimage.sh

darwin-dmg-arm64: darwin-build-arm64
    just _require-dmgbuild
    dmgbuild -s "{{dmg_settings}}" \
        -D app="{{dist}}/{{arch_darwin_arm64}}/{{app_name}}.app" \
        -D demo_dir="{{justfile_directory()}}" \
        "{{app_name}}" \
        "{{dist}}/{{app_name}}-v{{version}}-darwin-arm64.dmg"
    @echo ">>> Package: {{dist}}/{{app_name}}-v{{version}}-darwin-arm64.dmg"

darwin-dmg-x86_64: darwin-build-x86_64
    just _require-dmgbuild
    dmgbuild -s "{{dmg_settings}}" \
        -D app="{{dist}}/{{arch_darwin_x86}}/{{app_name}}.app" \
        -D demo_dir="{{justfile_directory()}}" \
        "{{app_name}}" \
        "{{dist}}/{{app_name}}-v{{version}}-darwin-x86_64.dmg"
    @echo ">>> Package: {{dist}}/{{app_name}}-v{{version}}-darwin-x86_64.dmg"

# ---------------------------------------------------------------------------
# Code signing / notarization
# ---------------------------------------------------------------------------

darwin-sign-arm64: darwin-build-arm64
    just _require-cert
    xattr -cr "{{dist}}/{{arch_darwin_arm64}}/{{app_name}}.app"
    codesign --deep --force --options runtime \
        --entitlements "{{entitlements}}" \
        --sign "${APPLE_DEVELOPER_CERTIFICATE_NAME}" \
        "{{dist}}/{{arch_darwin_arm64}}/{{app_name}}.app"
    @echo ">>> Signed: {{dist}}/{{arch_darwin_arm64}}/{{app_name}}.app"

darwin-sign-x86_64: darwin-build-x86_64
    just _require-cert
    xattr -cr "{{dist}}/{{arch_darwin_x86}}/{{app_name}}.app"
    codesign --deep --force --options runtime \
        --entitlements "{{entitlements}}" \
        --sign "${APPLE_DEVELOPER_CERTIFICATE_NAME}" \
        "{{dist}}/{{arch_darwin_x86}}/{{app_name}}.app"
    @echo ">>> Signed: {{dist}}/{{arch_darwin_x86}}/{{app_name}}.app"

darwin-notarize-arm64: darwin-sign-arm64
    just _require-notarize-env
    just _require-dmgbuild
    dmgbuild -s "{{dmg_settings}}" \
        -D app="{{dist}}/{{arch_darwin_arm64}}/{{app_name}}.app" \
        -D demo_dir="{{justfile_directory()}}" \
        "{{app_name}}" \
        "{{dist}}/{{app_name}}-v{{version}}-darwin-arm64.dmg"
    xcrun notarytool submit \
        "{{dist}}/{{app_name}}-v{{version}}-darwin-arm64.dmg" \
        --apple-id "${APPLE_ID}" \
        --password "${APPLE_DEVELOPER_APP_PASSWORD}" \
        --team-id "${APPLE_DEVELOPER_TEAM_ID}" \
        --wait
    xcrun stapler staple "{{dist}}/{{app_name}}-v{{version}}-darwin-arm64.dmg"
    @echo ">>> Notarized: {{dist}}/{{app_name}}-v{{version}}-darwin-arm64.dmg"

darwin-notarize-x86_64: darwin-sign-x86_64
    just _require-notarize-env
    just _require-dmgbuild
    dmgbuild -s "{{dmg_settings}}" \
        -D app="{{dist}}/{{arch_darwin_x86}}/{{app_name}}.app" \
        -D demo_dir="{{justfile_directory()}}" \
        "{{app_name}}" \
        "{{dist}}/{{app_name}}-v{{version}}-darwin-x86_64.dmg"
    xcrun notarytool submit \
        "{{dist}}/{{app_name}}-v{{version}}-darwin-x86_64.dmg" \
        --apple-id "${APPLE_ID}" \
        --password "${APPLE_DEVELOPER_APP_PASSWORD}" \
        --team-id "${APPLE_DEVELOPER_TEAM_ID}" \
        --wait
    xcrun stapler staple "{{dist}}/{{app_name}}-v{{version}}-darwin-x86_64.dmg"
    @echo ">>> Notarized: {{dist}}/{{app_name}}-v{{version}}-darwin-x86_64.dmg"

