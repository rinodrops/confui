# ---------------------------------------------------------------------------
# Internal
# ---------------------------------------------------------------------------

_ensure-icons:
    SCHEMA="{{justfile_directory()}}/{{schema_path}}" just --justfile {{root_just}} icons

_ensure-appicon-ico:
    just --justfile {{root_just}} appicon-ico

_darwin-bundle arch_slug rust_target:
    #!/usr/bin/env bash
    set -euo pipefail
    SCHEMA="{{justfile_directory()}}/{{schema_path}}"
    CONFIG="{{justfile_directory()}}/{{config_path}}"
    APP="{{dist}}/{{arch_slug}}/{{app_name}}.app"
    echo ">>> Building demo macOS .app  (arch: {{arch_slug}}, schema: ${SCHEMA})"
    MACOSX_DEPLOYMENT_TARGET="{{min_macos}}" SETTINGS_SCHEMA="${SCHEMA}" \
        cargo build --manifest-path ../Cargo.toml --release -p settings --target {{rust_target}}
    mkdir -p "${APP}/Contents/MacOS" "${APP}/Contents/Resources"
    cp "../target/{{rust_target}}/release/{{exe_name}}" "${APP}/Contents/MacOS/{{app_name}}"
    cp "${CONFIG}" "${APP}/Contents/Resources/config.toml"
    just --justfile {{root_just}} _darwin-write-plist "${APP}/Contents" jp.emotiongraphics.settings
    ICNS_BUNDLE="${APP}/Contents/Resources/AppIcon.icns"
    if [ -f "{{justfile_directory()}}/assets/AppIcon.icns" ]; then
        cp "{{justfile_directory()}}/assets/AppIcon.icns" "${ICNS_BUNDLE}"
    else
        just --justfile {{root_just}} _darwin-icns-if-present \
            "{{justfile_directory()}}/{{icon_src_macos}}" \
            "${ICNS_BUNDLE}"
    fi

_require-dmgbuild:
    #!/usr/bin/env bash
    command -v dmgbuild >/dev/null 2>&1 || \
        { echo "Error: dmgbuild not found. Run: pipx install dmgbuild" >&2; exit 1; }

_require-cert:
    #!/usr/bin/env bash
    test -n "${APPLE_DEVELOPER_CERTIFICATE_NAME:-}" || \
        { echo "Error: APPLE_DEVELOPER_CERTIFICATE_NAME is not set" >&2; exit 1; }

_require-notarize-env:
    #!/usr/bin/env bash
    test -n "${APPLE_DEVELOPER_TEAM_ID:-}" || \
        { echo "Error: APPLE_DEVELOPER_TEAM_ID is not set" >&2; exit 1; }
    test -n "${APPLE_ID:-}" || \
        { echo "Error: APPLE_ID is not set" >&2; exit 1; }
    test -n "${APPLE_DEVELOPER_APP_PASSWORD:-}" || \
        { echo "Error: APPLE_DEVELOPER_APP_PASSWORD is not set" >&2; exit 1; }

clean:
    rm -rf "{{dist}}" "{{win_target_dir}}"
